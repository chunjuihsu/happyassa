<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title | escape }} — {% endif %}{{ site.name | escape }}</title>
    <meta name="description" content="{{ (description or site.description) | escape }}">
    <meta name="color-scheme" content="light">
    <link rel="icon" href="/assets/icons/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/assets/icons/favicon-48x48.png">
    <link rel="icon" type="image/png" sizes="64x64" href="/assets/icons/favicon-64x64.png">
    <link rel="stylesheet" href="/assets/css/site.css">
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="wordmark" href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>{{ site.name | escape }}<span aria-hidden="true">.</span></a>
        <nav aria-label="Main navigation">
          <a href="/#projects">Projects</a>
          <a href="/#about">About</a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">{{ content | safe }}</main>
    <footer class="site-footer container">
      <a class="footer-name" href="/">{{ site.name | escape }}.</a>
      <a href="#main">Back to top <span aria-hidden="true">↑</span></a>
    </footer>
  </body>
</html>
