---
layout: layouts/base.njk
---
{% set homeUrl = '/' | switchLocaleUrl(locale) %}
<article class="article container">
  <a class="text-link" href="{{ homeUrl }}#projects"><span aria-hidden="true">←</span>{{ translations.allProjects | localeValue(locale) }}</a>
  <header class="article-header">
    <h1>{{ title | localeValue(locale) | escape }}</h1>
    {% if description %}<p class="article-description">{{ description | localeValue(locale) | escape }}</p>{% endif %}
  </header>
  <div class="prose">{{ content | safe }}</div>
  <div class="article-end"><a class="text-link" href="{{ homeUrl }}#projects">{{ translations.returnToProjects | localeValue(locale) }}<span aria-hidden="true">→</span></a></div>
</article>
