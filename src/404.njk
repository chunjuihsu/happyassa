---
layout: layouts/base.njk
pagination:
  data: locales.list
  size: 1
  alias: localeEntry
permalink: "{{ localeEntry.pathPrefix }}404.html"
eleventyComputed:
  locale: "{{ localeEntry.code }}"
  title: "{{ translations.notFoundTitle | localeValue(localeEntry.code) }}"
---
<div class="container not-found">
  <h1>{{ translations.notFoundHeading | localeValue(locale) }}</h1>
  <p>{{ translations.notFoundMessage | localeValue(locale) }}</p>
  <a class="text-link" href="{{ '/' | switchLocaleUrl(locale) }}">{{ translations.backHome | localeValue(locale) }} <span aria-hidden="true">→</span></a>
</div>
